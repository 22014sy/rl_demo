!rl_grasping_system/results/ablation/*.json
!rl_grasping_system/results/ablation_repro_20260910/*.json
!rl_grasping_system/results/mpc_plus_rl/*.json
!rl_grasping_system/results/mpc_plus_rl_v24/*.json
