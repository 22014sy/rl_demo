      contype="1" conaffinity="1" friction="0.5 0.3 0.01" mass="0.5"
      solimp="0.99 0.995 0.001" solref="0.01 1"/>
    <freejoint/>
  </body>
  <body name="obstacle_6" pos="1.000000 1.000000 1.000000">
    <geom type="sphere" size="0.05" rgba="0.9 0.1 0.9 1"
      contype="1" conaffinity="1" friction="0.5 0.3 0.01" mass="0.5"
      solimp="0.99 0.995 0.001" solref="0.01 1"/>
    <freejoint/>
  </body>

  </worldbody>

  <!-- ===== 臂关节速度控制 =====
       方案（Task3 最终）：arm 关节用 motor(力矩)，环境内实现"速度 PID + 重力补偿前馈"：
         tau = kp*(dq - qvel) + qfrc_bias（qfrc_bias = 重力+科氏+离心前馈）。
       纯 MuJoCo velocity-servo(biasprm=[0,0,-kp]) 在重力静载荷下会拉塌臂/力矩饱和，
       与真实 UR speedJ（内置 PID + 重力补偿）不一致；motor+PID 复刻真实行为。
       2F-85 手指用 menagerie fingers_actuator（ctrl 0-255 位置伺服, kp=100）。 -->
<contact>
    <exclude body1="rq_base" body2="rq_left_driver"/>
    <exclude body1="rq_base" body2="rq_right_driver"/>
    <exclude body1="rq_base" body2="rq_left_spring_link"/>
    <exclude body1="rq_base" body2="rq_right_spring_link"/>
    <exclude body1="rq_right_coupler" body2="rq_right_follower"/>
    <exclude body1="rq_left_coupler" body2="rq_left_follower"/>
  </contact>

<tendon>
    <fixed name="rq_split">
      <joint joint="rq_right_driver_joint" coef="0.5"/>
      <joint joint="rq_left_driver_joint" coef="0.5"/>
    </fixed>
  </tendon>

<equality>
    <connect anchor="0 0 0" body1="rq_right_follower" body2="rq_right_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <connect anchor="0 0 0" body1="rq_left_follower" body2="rq_left_coupler" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="rq_right_driver_joint" joint2="rq_left_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001"
      solref="0.005 1"/>
  </equality>

  <actuator>
    <motor name="shoulder_pan" joint="shoulder_pan_joint" ctrlrange="-150 150" forcerange="-150 150"/>
    <motor name="shoulder_lift" joint="shoulder_lift_joint" ctrlrange="-150 150" forcerange="-150 150"/>
    <motor name="elbow" joint="elbow_joint" ctrlrange="-150 150" forcerange="-150 150"/>
    <motor name="wrist_1" joint="wrist_1_joint" ctrlrange="-28 28" forcerange="-28 28"/>
    <motor name="wrist_2" joint="wrist_2_joint" ctrlrange="-28 28" forcerange="-28 28"/>
    <motor name="wrist_3" joint="wrist_3_joint" ctrlrange="-28 28" forcerange="-28 28"/>
    <general class="rq_2f85" name="fingers_actuator" tendon="rq_split" forcerange="-8 8" ctrlrange="0 255"
      gainprm="0.3137255 0 0" biasprm="0 -100 -10"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="-1.5708 -1.5708 1.5708 -1.5708 -1.5708 0" ctrl="-1.5708 -1.5708 1.5708 -1.5708 -1.5708 0"/>
  </keyframe>
</mujoco>
