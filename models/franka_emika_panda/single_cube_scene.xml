<mujoco model="panda scene with single cube">
  <include file="panda.xml"/>

  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    
    <!-- 单一目标物体材质 -->
    <material name="target_material" rgba="0.8 0.2 0.2 1" reflectance="0.3"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    
    <!-- 单一目标物体
         P0-1 修复记录：
           1) 新增 <freejoint/>：原模型 target_cube 是静态物体（无关节，焊接在世界上），
              夹爪永远无法把它抓起/抬升，这是“成功率恒为 0”的根因之一。
              加入 freejoint 后物体可自由运动，能被夹爪带动抬升。
           2) 尺寸 0.05(边长0.1m) -> 0.02(边长0.04m)：夹爪指尖内表面最大开口实测约
              0.056m，原 0.1m 物体根本放不进夹爪；0.04m 留有足够抓取余量。
           3) 显式给定质量/惯性，保证动力学确定性。
    -->
    <body name="target_cube" pos="0.5 0.0 0.1">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.064" diaginertia="1.7067e-5 1.7067e-5 1.7067e-5"/>
      <geom type="box" name="target_cube_geom" size="0.02 0.02 0.02" material="target_material"/>
    </body>
    
    <!-- 相机配置 -->
    <camera name="top_view" pos="0.5 0 1.5" quat="1 0 0 0" fovy="45"/>
    <camera name="side_view" pos="1.0 0 0.5" quat="0.707 0 0.707 0" fovy="45"/>
    <camera name="front_view" pos="0.5 1.0 0.5" quat="0.707 0.707 0 0" fovy="45"/>
  </worldbody>
</mujoco>
