  <equality>
    <joint joint1="finger_joint1" joint2="finger_joint2" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <actuator>
    <!-- P2-1 arm servo stiffness fix (2026-08-19): 原位置伺服刚度不足，重载下稳态下垂
         ~10mm（error=负载/增益：joint2 -29Nm/4500、joint4 18.4Nm/3500 恰好解释实测
         0.369°/0.301° 误差），使 run_lift_primitive 的绝对抬升目标达不到。
         增益×10（biasprm 阻尼同比×10，阻尼比不变，伺服动态特性保持一致）→ 下垂 ~1mm，
         近似真实 Panda 高增益+重力补偿的位置控制（跟踪精度 mm 级）。 -->
    <general class="panda" name="actuator1" joint="joint1" gainprm="45000" biasprm="0 -45000 -4500"/>
    <general class="panda" name="actuator2" joint="joint2" gainprm="45000" biasprm="0 -45000 -4500"
      ctrlrange="-1.7628 1.7628"/>
    <general class="panda" name="actuator3" joint="joint3" gainprm="35000" biasprm="0 -35000 -3500"/>
    <general class="panda" name="actuator4" joint="joint4" gainprm="35000" biasprm="0 -35000 -3500"
      ctrlrange="-3.0718 -0.0698"/>
    <general class="panda" name="actuator5" joint="joint5" gainprm="20000" biasprm="0 -20000 -2000" forcerange="-12 12"/>
    <general class="panda" name="actuator6" joint="joint6" gainprm="20000" biasprm="0 -20000 -2000" forcerange="-12 12"
      ctrlrange="-0.0175 3.7525"/>
    <general class="panda" name="actuator7" joint="joint7" gainprm="20000" biasprm="0 -20000 -2000" forcerange="-12 12"/>
    <!-- Remap original ctrlrange (0, 0.04) to (0, 255): 0.04 * 100 / 255 = 0.01568627451 -->
    <!-- P2-1 grip authority fix (2026-08-19):
         原参数夹持力 = 100*len(肌腱长)，在 0.04m 物体处仅 ~2N，摩擦(μ=1)不足以抬起
         0.064kg 立方体（重量0.63N），抬起时物体下滑。
         第一轮加强（×10，biasprm[1]=-1000，gainprm=0.196）后实测接触法向力仅 5.2N
         （≈26% 肌腱张力，因衬垫只压入物体 ~1mm 的浅接触），立方体随手上移但仍以
         ~0.6mm/s 摩擦蠕滑，抬升 0.15 后比衬垫面低 ~13mm，仍达不到 hold 阈值。
         本轮再加强 7 倍（合计 ~140N 肌腱张力，接近真实 Panda 夹持力），biasprm 阻尼
         同比 ×7 保持阻尼比；gainprm 同比 ×7 保证 ctrl=255 张开力 = 350-7000*len 恒为正
         （len≤0.04 时 ≥70N），forcerange 加宽到 ±200 以免张开/闭合力被截断。
         语义不变：ctrl=0 闭合 / ctrl=255 张开，仅力/阻尼放大。 -->
    <general class="panda" name="actuator8" tendon="split" forcerange="-200 200" ctrlrange="0 255"
      gainprm="1.37254901961 0 0" biasprm="0 -7000 -350"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 0 0 -1.57079 0 1.57079 -0.7853 0.04 0.04" ctrl="0 0 0 -1.57079 0 1.57079 -0.7853 255"/>
  </keyframe>

  <contact>
    <exclude body1="link0" body2="link1"/>
  </contact>
