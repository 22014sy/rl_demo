<mujoco model="panda">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="panda">
      <material specular="0.5" shininess="0.25"/>
      <joint armature="0.1" damping="1" axis="0 0 1" range="-2.8973 2.8973"/>
      <general dyntype="none" biastype="affine" ctrlrange="-2.8973 2.8973" forcerange="-87 87"/>
      <default class="finger">
        <joint axis="0 1 0" type="slide" range="0 0.04"/>
      </default>

      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3"/>
        <!-- P4 (2026-08-20): 指尖衬垫接触加硬（solref=1ms/0.999（高刚））。
             实测：默认软接触(20ms)下 64g 立方体在 0.2m 抬升中蠕动倾覆、~0.075m 处滑脱；
             加硬 + 主衬垫加宽加高（大接触斑）后，配合 lift_speed=0.003 慢抬，
             立方体 100% 刚性跟随（~494 步到 0.2m、宽度恒 0.0345 不滑脱）。
             注：0.005 时仍有 ~6% 滞后滑移（伺服/动态滞后），0.003 消除之。 -->
        <default class="fingertip_pad_collision_1">
          <geom type="box" solref="0.001 1" solimp="0.999 0.999 0.001" size="0.012 0.004 0.015" pos="0 0.0055 0.0445"/>
        </default>
        <default class="fingertip_pad_collision_2">
          <geom type="box" solref="0.001 1" solimp="0.999 0.999 0.001" size="0.003 0.002 0.003" pos="0.0055 0.002 0.05"/>
        </default>
        <default class="fingertip_pad_collision_3">
          <geom type="box" solref="0.001 1" solimp="0.999 0.999 0.001" size="0.003 0.002 0.003" pos="-0.0055 0.002 0.05"/>
        </default>
        <default class="fingertip_pad_collision_4">
          <geom type="box" solref="0.001 1" solimp="0.999 0.999 0.001" size="0.003 0.002 0.0035" pos="0.0055 0.002 0.0395"/>
        </default>
        <default class="fingertip_pad_collision_5">
          <geom type="box" solref="0.001 1" solimp="0.999 0.999 0.001" size="0.003 0.002 0.0035" pos="-0.0055 0.002 0.0395"/>
        </default>
      </default>
    </default>
  </default>

